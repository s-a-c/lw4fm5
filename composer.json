{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/livewire-starter-kit",
    "type": "project",
    "description": "The official Laravel starter kit for Livewire.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "repositories": {
        "fluxui-pro": {
            "type": "composer",
            "url": "https://composer.fluxui.dev"
        },
        "laravel-comments": {
            "type": "composer",
            "url": "https://satis.spatie.be"
        },
        "laravel-labs-starter-kit-browser-tests": {
            "type": "vcs",
            "url": "https://github.com/laravel-labs/starter-kit-browser-tests"
        }
    },
    "require": {
        "php": "^8.4",
        "ably/ably-php": "^1.1",
        "ably/laravel-broadcaster": "^1.0",
        "askedio/laravel-soft-cascade": "^12.0",
        "cweagans/composer-patches": "^2.0",
        "filament/filament": "^5.x-dev",
        "laravel/folio": "dev-master",
        "laravel/fortify": "^1.32",
        "laravel/framework": "^12.40",
        "laravel/horizon": "^5.40",
        "laravel/mcp": "^v0.3",
        "laravel/octane": "^2.13",
        "laravel/reverb": "^1.6",
        "laravel/sanctum": "^4.2",
        "laravel/scout": "^10.22",
        "laravel/telescope": "^5.15",
        "laravel/tinker": "^2.10",
        "laravel/workos": "^0.5",
        "livewire/flux": "^2.9",
        "livewire/flux-pro": "^2.9",
        "livewire/livewire": "^4.0",
        "livewire/volt": "^1.10",
        "monolog/monolog": "^3.9",
        "moonshine/moonshine": "^4.0",
        "runtime/frankenphp-symfony": "^0.2.0",
        "spatie/laravel-activitylog": "^4.10",
        "spatie/laravel-analytics": "^5.6",
        "spatie/laravel-backup": "^9.3",
        "spatie/laravel-csp": "^3.21",
        "spatie/laravel-data": "^4.18",
        "spatie/laravel-deleted-models": "^1.1",
        "spatie/laravel-event-sourcing": "^7.12",
        "spatie/laravel-health": "^1.34",
        "spatie/laravel-markdown": "^2.7",
        "spatie/laravel-medialibrary": "^11.17",
        "spatie/laravel-model-states": "^2.12",
        "spatie/laravel-model-status": "^1.18",
        "spatie/laravel-schedule-monitor": "^4.1",
        "spatie/laravel-settings": "^3.5",
        "turso/libsql-laravel": "*",
        "typesense/typesense-php": "^5.2"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.16",
        "barryvdh/laravel-ide-helper": "^3.6",
        "driftingly/rector-laravel": "^2.1",
        "ergebnis/composer-normalize": "^2.48",
        "fakerphp/faker": "^1.24",
        "infection/infection": "^0.31",
        "jasonmccreary/laravel-test-assertions": "^2.8",
        "larastan/larastan": "^3.8",
        "laravel-labs/starter-kit-browser-tests": "dev-main",
        "laravel-shift/blueprint": "^2.13",
        "laravel/boost": "^1.8",
        "laravel/pail": "^1.2",
        "laravel/pint": "^1.26",
        "laravel/sail": "^1.48",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.8",
        "pestphp/pest": "^4.1",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-browser": "^4.1",
        "pestphp/pest-plugin-faker": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "pestphp/pest-plugin-profanity": "^4.2",
        "pestphp/pest-plugin-type-coverage": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^12.4",
        "rector/rector": "^2.2",
        "rector/type-perfect": "^2.1",
        "roave/security-advisories": "dev-latest",
        "soloterm/solo": "^0.5",
        "spatie/laravel-horizon-watcher": "^1.1",
        "spatie/laravel-login-link": "^1.6",
        "spatie/laravel-missing-page-redirector": "^2.11",
        "spatie/laravel-queueable-action": "^2.16",
        "spatie/laravel-ray": "^1.43",
        "spatie/laravel-web-tinker": "^1.10",
        "spatie/pest-plugin-snapshots": "^2.2"
    },
    "autoload": {
        "exclude-from-classmap": [
            "vendor/league/flysystem/src/Local/*",
            "vendor/laravel/pint/app/Providers/*"
        ],
        "files": [
            "app/helpers.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "ci:local": "bash scripts/run-ci-checks.sh",
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "bunx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"bun run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "lint": [
            "php -d memory_limit=1G vendor/bin/rector",
            "php -d memory_limit=1G vendor/bin/pint --parallel",
            "bun run lint"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "security:audit": "composer audit --locked || true",
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "bun install",
            "bun run build"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@test:lint",
            "@test:type-coverage",
            "@test:coverage",
            "@test:unit",
            "@test:types",
            "@security:audit"
        ],
        "test:browser": [
            "php -d error_reporting=\"E_ALL & ~E_DEPRECATED & ~E_USER_DEPRECATED\" -d memory_limit=1G vendor/bin/pest --testsuite=Browser --parallel --processes=4"
        ],
        "test:coverage": [
            "@test:coverage:pcov",
            "@test:coverage:js"
        ],
        "test:coverage:pcov": "php -d error_reporting=\"E_ALL & ~E_DEPRECATED & ~E_USER_DEPRECATED\" -d memory_limit=1G -d xdebug.mode=off -d pcov.enabled=1 vendor/bin/pest --coverage --min=100 2>&1 | php -r \"while(\\$line = fgets(STDIN)) { echo chr(27) . '[0;34m[php-coverage:pcov]' . chr(27) . '[0m ' . \\$line; }\" || true",
        "test:coverage:xdebug": "php -d error_reporting=\"E_ALL & ~E_DEPRECATED & ~E_USER_DEPRECATED\" -d memory_limit=1G -d xdebug.mode=coverage -d pcov.enabled=0 -r \"if (!extension_loaded('xdebug') || ini_get('xdebug.mode') !== 'coverage') { echo chr(27) . '[0;35m[php-coverage:xdebug]' . chr(27) . '[0m xdebug driver not available' . PHP_EOL; exit(0); } if (extension_loaded('pcov')) { echo chr(27) . '[0;35m[php-coverage:xdebug]' . chr(27) . '[0m Warning: pcov is loaded, Pest will prefer pcov over xdebug. Consider disabling pcov extension for xdebug coverage.' . PHP_EOL; }\" && vendor/bin/pest --coverage --min=100 2>&1 | php -r \"while(\\$line = fgets(STDIN)) { echo chr(27) . '[0;35m[php-coverage:xdebug]' . chr(27) . '[0m ' . \\$line; }\" || php -r \"echo chr(27) . '[0;35m[php-coverage:xdebug]' . chr(27) . '[0m xdebug driver not available' . PHP_EOL;\" || true",
        "test:coverage:js": "bun run test:coverage 2>&1 | php -r \"while(\\$line = fgets(STDIN)) { echo chr(27) . '[0;36m[js-coverage]' . chr(27) . '[0m ' . \\$line; }\" || true",
        "test:lint": [
            "php -d memory_limit=1G vendor/bin/pint --parallel --test",
            "php -d memory_limit=1G vendor/bin/rector --dry-run",
            "bun run test:lint"
        ],
        "test:mutation": "php -d error_reporting=\"E_ALL & ~E_DEPRECATED & ~E_USER_DEPRECATED\" -d memory_limit=1G vendor/bin/infection --min-msi=90 --threads=4 --formatter=progress --show-mutations --force-progress",
        "test:theme": "php -d error_reporting=\"E_ALL & ~E_DEPRECATED & ~E_USER_DEPRECATED\" -d memory_limit=1G vendor/bin/pest --filter=Theme --covereage --min=100 --parallel --processes=4",
        "test:type-coverage": "php -d error_reporting=\"E_ALL & ~E_DEPRECATED & ~E_USER_DEPRECATED\" -d memory_limit=1G vendor/bin/pest --type-coverage --min=100",
        "test:types": "php -d memory_limit=1G vendor/bin/phpstan analyse --memory-limit=1G",
        "test:unit": "php -d error_reporting=\"E_ALL & ~E_DEPRECATED & ~E_USER_DEPRECATED\" -d memory_limit=1G -d xdebug.mode=coverage vendor/bin/pest --testsuite=Unit,Feature --coverage --min=100",
        "update:requirements": [
            "composer bump",
            "bunx npm-check-updates -u"
        ],
        "workflow:core": [
            "@test:lint",
            "@test:unit",
            "@test:types",
            "@security:audit"
        ],
        "workflow:heavy": [
            "@test:mutation",
            "@test:browser"
        ],
        "workflow:policy": [
            "php artisan policy:checksum-monitor"
        ]
    },
    "config": {
        "allow-plugins": {
            "cweagans/composer-patches": true,
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "symfony/runtime": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "process-timeout": 1800,
        "sort-packages": true
    },
    "extra": {
        "composer-exit-on-patch-failure": true,
        "laravel": {
            "dont-discover": [
                "moonshine/moonshine"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
