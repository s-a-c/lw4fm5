{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "laravel/livewire-starter-kit",
  "type": "project",
  "description": "The official Laravel starter kit for Livewire.",
  "keywords": [
    "laravel",
    "framework"
  ],
  "license": "MIT",
  "repositories": {
    "flux-pro": {
      "type": "composer",
      "url": "https://composer.fluxui.dev"
    },
    "laravel-comments": {
      "type": "composer",
      "url": "https://satis.spatie.be"
    }
  },
  "require": {
    "php": "^8.5",
    "ably/ably-php": "^1.1",
    "ably/laravel-broadcaster": "^1.0",
    "askedio/laravel-soft-cascade": "^12.0",
    "filament/filament": "^5.x-dev",
    "laravel/folio": "dev-master",
    "laravel/fortify": "^1.31",
    "laravel/framework": "^12.36",
    "laravel/horizon": "^5.38",
    "laravel/mcp": "^v0.3",
    "laravel/octane": "^2.13",
    "laravel/reverb": "^1.0",
    "laravel/sanctum": "^4.0",
    "laravel/scout": "^10.20",
    "laravel/telescope": "^5.15",
    "laravel/tinker": "^2.10",
    "laravel/workos": "^0.5",
    "livewire/flux": "^2.6",
    "livewire/flux-pro": "^2.6",
    "livewire/livewire": "^4.0",
    "livewire/volt": "dev-main",
    "runtime/frankenphp-symfony": "^0.2.0",
    "spatie/laravel-activitylog": "^4.10",
    "spatie/laravel-analytics": "^5.6",
    "spatie/laravel-backup": "^9.3",
    "spatie/laravel-event-sourcing": "^7.12",
    "spatie/laravel-health": "^1.34",
    "spatie/laravel-markdown": "^2.7",
    "spatie/laravel-medialibrary": "^11.17",
    "spatie/laravel-schedule-monitor": "^4.1",
    "spatie/laravel-settings": "^3.5",
    "typesense/typesense-php": "^5.2.0-RC4"
  },
  "require-dev": {
    "barryvdh/laravel-debugbar": "^3.13",
    "barryvdh/laravel-ide-helper": "^3.6",
    "driftingly/rector-laravel": "^2.1",
    "ergebnis/composer-normalize": "^2.48",
    "fakerphp/faker": "^1.24",
    "jasonmccreary/laravel-test-assertions": "^2.8",
    "larastan/larastan": "^3.8",
    "laravel-shift/blueprint": "^2.12",
    "laravel/boost": "^1.6",
    "laravel/pail": "^1.2",
    "laravel/pint": "^1.25",
    "laravel/sail": "^1.47",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.8",
    "pestphp/pest": "^4.1",
    "pestphp/pest-plugin-arch": "^4.0",
    "pestphp/pest-plugin-browser": "^4.1",
    "pestphp/pest-plugin-faker": "^4.0",
    "pestphp/pest-plugin-laravel": "^4.0",
    "pestphp/pest-plugin-profanity": "^4.2",
    "pestphp/pest-plugin-type-coverage": "^4.0",
    "phpstan/extension-installer": "^1.3",
    "phpstan/phpstan": "^2.1.32",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpstan/phpstan-phpunit": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpunit/phpunit": "^12.4",
    "rector/rector": "^2.2",
    "rector/type-perfect": "^2.1",
    "roave/security-advisories": "dev-latest",
    "soloterm/solo": "^0.5.0",
    "spatie/laravel-blade-comments": "^2.0",
    "spatie/laravel-horizon-watcher": "^1.1",
    "spatie/laravel-login-link": "^1.6",
    "spatie/laravel-missing-page-redirector": "^2.11",
    "spatie/laravel-queueable-action": "^2.16",
    "spatie/laravel-ray": "^1.41",
    "spatie/laravel-web-tinker": "^1.10",
    "spatie/pest-plugin-snapshots": "^2.2"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    },
    "exclude-from-classmap": [
      "vendor/league/flysystem/src/Local/*",
      "vendor/laravel/pint/app/Providers/*"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "setup": [
      "composer install",
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
      "@php artisan key:generate",
      "@php artisan migrate --force",
      "bun install",
      "bun run build"
    ],
    "dev": [
      "Composer\\Config::disableProcessTimeout",
      "bunx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"bun run dev\" --names=server,queue,logs,vite --kill-others"
    ],
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi",
      "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
      "@php artisan migrate --graceful --ansi"
    ],
    "pre-package-uninstall": [
      "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
    ],
    "update:requirements": [
      "composer bump",
      "bunx npm-check-updates -u"
    ],
    "lint": [
      "rector",
      "pint --parallel",
      "bun run lint"
    ],
    "workflow:core": [
      "@test:lint",
      "@test:unit",
      "@test:types",
      "@security:audit"
    ],
    "workflow:heavy": [
      "@test:mutation",
      "bunx playwright test"
    ],
    "workflow:policy": [
      "php artisan policy:checksum-monitor"
    ],
    "test:type-coverage": "pest --type-coverage --min=100",
    "test:lint": [
      "pint --parallel --test",
      "rector --dry-run",
      "bun run test:lint"
    ],
    "test:mutation": "vendor/bin/infection --min-msi=90 --threads=4",
    "test:coverage": "pest --coverage",
    "security:audit": "composer audit --locked || true",
    "test:unit": "pest --parallel --coverage --exactly=100.0",
    "test:types": "phpstan",
    "test": [
      "@php artisan config:clear --ansi",
      "@test:type-coverage",
      "@test:unit",
      "@test:lint",
      "@test:types",
      "@security:audit"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "ergebnis/composer-normalize": true,
      "pestphp/pest-plugin": true,
      "php-http/discovery": true,
      "phpstan/extension-installer": true,
      "symfony/runtime": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
