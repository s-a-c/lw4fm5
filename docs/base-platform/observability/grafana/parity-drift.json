{
  "id": null,
  "uid": "base-platform-parity",
  "title": "Base Platform • Parity Drift",
  "tags": ["base-platform", "parity"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "panels": [
    {
      "type": "timeseries",
      "title": "Parity Drift Events",
      "id": 1,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "rate(base_platform_parity_result_total{status=\"drift\"}[30m])",
          "legendFormat": "{{profile}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 0.1},
              {"color": "red", "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 0},
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "stat",
      "title": "Last Drift Timestamp",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "max_over_time(base_platform_parity_last_failure_timestamp[24h])",
          "legendFormat": "last_drift"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "fixed",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 9}
    },
    {
      "type": "table",
      "title": "Recent Validation Failures",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "topk(5, base_platform_environment_validation_failures_total)",
          "legendFormat": "{{profile}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {"h": 6, "w": 16, "x": 8, "y": 9}
    }
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "Prometheus"
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Annotations & Alerts",
        "type": "dashboard",
        "enable": true,
        "builtIn": 1,
        "iconColor": "rgba(0, 211, 255, 1)"
      }
    ]
  },
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "editable": true
}
