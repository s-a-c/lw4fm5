includes:
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon

parameters:

    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - public
        - routes
        - tests

    excludePaths:
        - database/migrations/*.php

    level: max

    tmpDir: /tmp/phpstan

    ignoreErrors:
        # Pest internal class access - these are expected patterns
        - '#Call to method .+ of internal class Pest\\Mixins\\Expectation.* from outside its root namespace Pest#'
        - '#Call to method .+ of internal class Pest\\PendingCalls\\.+ from outside its root namespace Pest#'
        - '#Call to method .+ of internal class Pest\\Configuration from outside its root namespace Pest#'
        - '#Access to constant on internal class Pest\\Mutate\\Plugins\\Mutate#'
        # Pest expect() syntax with $not property - Fixed with assert() type narrowing
        # Removed: expect()->not-> patterns now use assert() for type narrowing
        # Mockery expectations - fluent interface pattern
        - '#Call to an undefined method Mockery\\ExpectationInterface.*#'
        -
            message: '#Cannot call method (andReturn|andThrow|with|once)\(\) on mixed\.#'
            paths:
                - tests/**/*.php
        # Laravel test helpers from TestCase trait - Fixed with PHPDoc @method tags
        # Removed: TestCase.php now has proper @method PHPDoc for all trait methods
        # Laravel command testing
        -
            message: '#Cannot call method (expectsOutputToContain|assertExitCode)\(\) on#'
            paths:
                - tests/**/*.php
        # Dynamic method calls that are valid in tests
        -
            message: '#Dynamic call to static method .+::(count|insert)\(\)#'
            paths:
                - tests/**/*.php
        -
            message: '#Dynamic call to static method Illuminate\\Contracts\\Auth\\Guard::check\(\)#'
            paths:
                - tests/**/*.php
        # Internal class access for testing - Fixed with @phpstan-ignore-next-line
        # Removed: BootstrapRecoveryGuidance access now uses targeted annotations
        # Pest helper function issues - Fixed with annotations
        # Removed: freezeTime() and $this issues resolved with proper annotations
        # Pest Laravel helper functions (globally available)
        -
            message: '#Function (assertAuthenticated|assertGuest|assertDatabaseHas|skip) not found\.#'
            paths:
                - tests/**/*.php
        # Pest plugin arch (preset and expect methods) - Fixed with @phpstan-ignore-next-line
        # Removed: arch() calls now use targeted annotations
        # Trait unused warnings (test traits are used via Pest configuration)
        -
            message: '#Trait .+ is used zero times and is not analysed#'
            paths:
                - tests/**/*.php
        # Type issues in test data - Fixed with explicit type annotations
        # Removed: ParityReport issues parameter now uses list<string> type annotations
        # Nullable access in tests (tests verify null handling)
        -
            message: '#Cannot access property \$(name|classification|id) on#'
            paths:
                - tests/**/*.php
        -
            message: '#Cannot call method (hasVerifiedEmail|isOverdue|toArray)\(\) on#'
            paths:
                - tests/**/*.php
        # Array offset access in tests (test data arrays)
        -
            message: '#Cannot access offset .+ on mixed#'
            paths:
                - tests/**/*.php
        # Test helper methods and properties - Fixed with type annotations
        # Removed: appendTimestamps() and $app access now use proper type hints
        -
            message: '#Parameter .+ expects .+, mixed given#'
            paths:
                - tests/**/*.php
        # Collection template type issues in tests
        -
            message: '#Unable to resolve the template type .+ in call to static method Illuminate\\Support\\Collection.*::make\(\)#'
            paths:
                - tests/**/*.php
        # Cast and condition issues in tests
        -
            message: "#Casting to string something that's already string#"
            paths:
                - tests/**/*.php
        # Generic test issues
        -
            message: '#Trying to invoke mixed but.*not a callable#'
            paths:
                - tests/**/*.php
        -
            message: '#Cannot access property \$token on mixed#'
            paths:
                - tests/**/*.php
        # Mockery type compatibility - Mockery mocks implement LegacyMockInterface, not the original interface
        -
            message: '#Parameter .+ expects .+, Mockery\\LegacyMockInterface given#'
            paths:
                - tests/**/*.php
        # Test-specific isset/ternary checks - these are intentional edge case tests
        -
            message: '#Offset .+ on array\{.+\} in isset\(\) always exists and is not nullable#'
            paths:
                - tests/**/*.php
        -
            message: '#Ternary operator condition is always true#'
            paths:
                - tests/**/*.php
        # Mockery property access - Fixed with type annotations
        # Removed: Mockery property access now uses proper @phpstan-var annotations
        # Filament class not found - Fixed with @phpstan-ignore-next-line
        # Removed: AlpineComponent access now uses targeted annotations
        # Type coverage warnings (informational, not blocking)
        -
            message: '#Out of .+ possible param types, only .+ - .+ % actually have it#'
            paths:
                - tests/**/*.php
        # Impossible type checks in tests (intentional test cases)
        -
            message: '#Call to function is_string\(\) with array\{\} will always evaluate to false#'
            paths:
                - tests/**/*.php
